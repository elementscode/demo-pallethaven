import "./style.css";
import { LiveView, session } from "@elements/app";
import { Alert } from "@elements/ui/alert";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardContent, CardFooter } from "@elements/ui/card";
import { Field, FieldDescription, FieldLabel } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { NativeSelect } from "@elements/ui/native-select";
import { NumberInput } from "@elements/ui/number-input";
import { Table, TableCell, TableHead } from "@elements/ui/table";
import { toast } from "@elements/ui/toast";
import { ToggleGroup, ToggleGroupItem } from "@elements/ui/toggle-group";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { formatWhen } from "#app/shared/lib/format";
import {
  Adjustment,
  Product,
  StockMovement,
  adjustStock,
  formatMoney,
  isLow,
  updateProduct,
} from "#app/shared/services/inventory";
import { poNumber } from "#app/shared/services/purchasing";

export interface SupplierOption {
  id: string;
  name: string;
}

export interface OnOrder {
  purchaseOrderId: string;
  number: number;
  remaining: number;
}

type Reason = Adjustment["reason"];

interface AdjustForm {
  reason: Reason;
  quantity: number;
  note: string;
  error: string;
  busy: boolean;
}

interface EditForm {
  open: boolean;
  name: string;
  supplierId: string;
  cost: string;
  reorderPoint: number;
  error: string;
}

const REASONS: { value: Reason; label: string }[] = [
  { value: "count", label: "Count" },
  { value: "damage", label: "Damage" },
  { value: "sale", label: "Sale" },
];

const MOVEMENT_LABELS: Record<StockMovement["reason"], string> = {
  count: "Stock count",
  damage: "Damage",
  sale: "Sale",
  receipt: "Received",
};

export function projected(onHand: number, form: { reason: Reason; quantity: number }): number {
  let quantity = Math.trunc(Number(form.quantity) || 0);

  return form.reason === "count" ? quantity : onHand - quantity;
}

function emptyAdjust(onHand: number): AdjustForm {
  return { reason: "count", quantity: onHand, note: "", error: "", busy: false };
}

function onReason(form: AdjustForm, product: Product, reason: Reason) {
  form.reason = reason;
  form.quantity = reason === "count" ? product.onHand : 1;
  form.error = "";
}

function onAdjust(form: AdjustForm, product: Product) {
  form.busy = true;
  form.error = "";

  try {
    adjustStock({ productId: product.id, reason: form.reason, quantity: form.quantity, note: form.note });
    toast.success(`${MOVEMENT_LABELS[form.reason]} recorded.`);
    form.note = "";
    form.quantity = form.reason === "count" ? product.onHand : 1;
  } catch (err: any) {
    form.error = err.message;
  }

  form.busy = false;
}

function openEdit(edit: EditForm, product: Product) {
  edit.open = true;
  edit.error = "";
  edit.name = product.name;
  edit.supplierId = product.supplierId;
  edit.cost = (product.costCents / 100).toFixed(2);
  edit.reorderPoint = product.reorderPoint;
}

function onSaveEdit(edit: EditForm, product: Product) {
  try {
    updateProduct({
      productId: product.id,
      name: edit.name,
      supplierId: edit.supplierId,
      cost: edit.cost,
      reorderPoint: edit.reorderPoint,
    });

    edit.open = false;
  } catch (err: any) {
    edit.error = err.message;
  }
}

function fillPercent(p: Product): number {
  let scale = Math.max(p.reorderPoint * 3, p.onHand, 1);

  return Math.min(100, (p.onHand / scale) * 100);
}

function markPercent(p: Product): number {
  let scale = Math.max(p.reorderPoint * 3, p.onHand, 1);

  return Math.min(100, (p.reorderPoint / scale) * 100);
}

<html lang="en" class="page-product" (
  products: LiveView<Product>,
  movements: LiveView<StockMovement>,
  suppliers: SupplierOption[],
  onOrder: OnOrder[],
  private form: AdjustForm = emptyAdjust(products.at(0)?.onHand ?? 0),
  private edit: EditForm = { open: false, name: "", supplierId: "", cost: "", reorderPoint: 0, error: "" },
)>
  <head>
    <title>{products.at(0)?.name ?? "Product"} · Pallethaven</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout active="stock">
      <div e:for={product of products} class="stack is-xl">
        <div class="stack is-sm">
          <a class="crumb" href="/">← Stock</a>
          <div class="product-title">
            <h1>{product.name}</h1>
          </div>
          <div class="product-meta cluster">
            <span class="sku">{product.sku}</span>
            <span>{product.supplierName}</span>
            <span>{formatMoney(product.costCents)} per unit</span>
          </div>
        </div>

        <div class="product-grid">
          <div class="stack is-lg">
            <Card>
              <CardContent class="stack">
                <div class="level">
                  <div>
                    <div class="level-label">On hand</div>
                    <div class={["level-value", isLow(product) && "is-low", product.onHand === 0 && "is-out"]}>
                      {product.onHand}
                    </div>
                  </div>
                  <div>
                    <div class="level-label">Reorder at</div>
                    <div class="level-value">{product.reorderPoint}</div>
                  </div>
                  <div class="level-bar" aria-hidden="true">
                    <div class={["level-fill", isLow(product) && "is-low"]} style={{ width: `${fillPercent(product)}%` }}></div>
                    <div class="level-mark" style={{ left: `${markPercent(product)}%` }}></div>
                  </div>
                </div>
                <div class="cluster is-sm">
                  <Badge e:if={product.onHand === 0} variant="danger" dot>Out of stock</Badge>
                  <Badge e:elseif={isLow(product)} variant="warning" dot>At or under reorder point</Badge>
                  <Badge e:else variant="success" dot>In stock</Badge>
                </div>
                <p e:if={onOrder.length > 0} class="on-order">
                  On order:
                  <span e:for={o of onOrder}>
                    <a href={`/purchase-orders/${o.purchaseOrderId}`}>{o.remaining} on {poNumber(o.number)}</a>
                  </span>
                </p>
              </CardContent>
            </Card>

            <Card title="Adjust stock" level={2}>
              <form onsubmit={() => onAdjust(form, product)}>
                <CardContent class="stack">
                  <ToggleGroup class="reason-picker"
                               value={form.reason}
                               variant="outline"
                               size="sm"
                               label="Reason"
                               onValueChange={(v, details) => v ? onReason(form, product, v as Reason) : details.cancel()}>
                    <ToggleGroupItem e:for={r of REASONS} value={r.value}>{r.label}</ToggleGroupItem>
                  </ToggleGroup>

                  <Field label={form.reason === "count" ? "Counted on the shelf" : "Units removed"} required>
                    <NumberInput value={form.quantity} min={0} />
                    <FieldDescription>
                      On hand goes from {product.onHand} to <strong>{projected(product.onHand, form)}</strong>.
                    </FieldDescription>
                  </Field>

                  <Field>
                    <FieldLabel>Note <span class="hint">optional</span></FieldLabel>
                    <Input value={form.note} placeholder={form.reason === "damage" ? "What happened?" : ""} />
                  </Field>

                  <Alert e:if={form.error} variant="danger" description={form.error} />

                  <Button type="submit" variant="primary" block loading={form.busy}>
                    Record {form.reason === "count" ? "count" : form.reason}
                  </Button>
                </CardContent>
              </form>
            </Card>

            <Card e:if={session.get("role") === "manager"} title="Details" level={2}>
              <CardContent e:if={!edit.open} class="stack is-sm">
                <p class="card-note">Name, supplier, unit cost and reorder point.</p>
                <Button size="sm" onclick={() => openEdit(edit, product)}>Edit details</Button>
              </CardContent>
              <form e:else onsubmit={() => onSaveEdit(edit, product)}>
                <CardContent class="stack">
                  <Alert e:if={edit.error} variant="danger" description={edit.error} />
                  <Field label="Name" required>
                    <Input value={edit.name} />
                  </Field>
                  <Field label="Supplier">
                    <NativeSelect value={edit.supplierId} block options={suppliers.map((s) => ({ value: s.id, label: s.name }))} />
                  </Field>
                  <Field label="Unit cost" required>
                    <Input value={edit.cost} attrs={{ inputmode: "decimal" }} />
                  </Field>
                  <Field label="Reorder point">
                    <NumberInput value={edit.reorderPoint} min={0} />
                  </Field>
                </CardContent>
                <CardFooter>
                  <Button variant="ghost" onclick={() => edit.open = false}>Cancel</Button>
                  <Button type="submit" variant="primary">Save</Button>
                </CardFooter>
              </form>
            </Card>
          </div>

          <Card title="Movement history" level={2} class="history-card">
            <Table label="Movement history" class="history-table">
              <table>
                <thead>
                  <tr>
                    <TableHead>When</TableHead>
                    <TableHead>Reason</TableHead>
                    <TableHead align="end">Change</TableHead>
                    <TableHead align="end">After</TableHead>
                    <TableHead class="col-by">By</TableHead>
                  </tr>
                </thead>
                <tbody>
                  <tr e:for={m of movements}>
                    <TableCell class="when">{formatWhen(m.createdAt)}</TableCell>
                    <TableCell class="reason">
                      <div>
                        {MOVEMENT_LABELS[m.reason]}
                        <a e:if={m.purchaseOrderId && m.purchaseOrderNumber}
                           href={`/purchase-orders/${m.purchaseOrderId}`}>
                          on {poNumber(m.purchaseOrderNumber ?? 0)}
                        </a>
                      </div>
                      <div e:if={m.note} class="note">{m.note}</div>
                    </TableCell>
                    <TableCell align="end" class={["delta", m.delta > 0 && "is-up", m.delta < 0 && "is-down"].filter(Boolean).join(" ")}>
                      {m.delta > 0 ? `+${m.delta}` : m.delta === 0 ? "±0" : `${m.delta}`}
                    </TableCell>
                    <TableCell align="end">{m.quantityAfter}</TableCell>
                    <TableCell class="col-by note">{m.userName}</TableCell>
                  </tr>
                </tbody>
              </table>
            </Table>
            <CardFooter e:if={movements.hasMore} class="history-more">
              <Button variant="ghost" size="sm" onclick={() => movements.more()}>Show older</Button>
            </CardFooter>
          </Card>
        </div>
      </div>
    </Layout>
  </body>
</html>
