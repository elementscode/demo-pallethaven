import "./style.css";
import { LiveView, redirect, session } from "@elements/app";
import { Alert } from "@elements/ui/alert";
import { AlertDialog, AlertDialogAction, AlertDialogCancel, AlertDialogFooter } from "@elements/ui/alert-dialog";
import { Badge } from "@elements/ui/badge";
import { Button } from "@elements/ui/button";
import { Card, CardContent } from "@elements/ui/card";
import { Empty } from "@elements/ui/empty";
import { Field } from "@elements/ui/field";
import { NativeSelect } from "@elements/ui/native-select";
import { NumberInput } from "@elements/ui/number-input";
import { Table, TableCell, TableHead } from "@elements/ui/table";
import { toast } from "@elements/ui/toast";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { formatWhen } from "#app/shared/lib/format";
import { Product, formatMoney, isLow } from "#app/shared/services/inventory";
import {
  PoLine,
  PoStatus,
  PurchaseOrder,
  STATUS_LABELS,
  addLine,
  deletePurchaseOrder,
  poNumber,
  receiveAll,
  receiveLine,
  removeLine,
  sendPurchaseOrder,
  setLineQuantity,
  statusVariant,
  suggestedQuantity,
} from "#app/shared/services/purchasing";

interface Action {
  error: string;
  busy: boolean;
}

interface AddForm {
  productId: string;
  quantity: number;
  error: string;
}

interface LineState {
  quantity: number;
}

const STEPS: PoStatus[] = ["draft", "sent", "partially_received", "received"];

function isManager(): boolean {
  return session.get("role") === "manager";
}

function stepDone(order: PurchaseOrder, step: PoStatus): boolean {
  return STEPS.indexOf(order.status) >= STEPS.indexOf(step);
}

function sortedLines(lines: LiveView<PoLine>): PoLine[] {
  return lines.sort((a, b) => a.sku.localeCompare(b.sku));
}

function addable(products: LiveView<Product>, lines: LiveView<PoLine>, order: PurchaseOrder): Product[] {
  return products
    .filter((p) => p.supplierId === order.supplierId && !lines.find((l) => l.productId === p.id))
    .sort((a, b) => Number(isLow(b)) - Number(isLow(a)) || a.sku.localeCompare(b.sku));
}

function onSend(action: Action, order: PurchaseOrder) {
  action.busy = true;
  action.error = "";

  try {
    sendPurchaseOrder(order.id);
  } catch (err: any) {
    action.error = err.message;
  }

  action.busy = false;
}

function onDelete(action: Action, order: PurchaseOrder) {
  action.busy = true;
  action.error = "";

  try {
    deletePurchaseOrder(order.id);
    redirect("/purchase-orders");
  } catch (err: any) {
    action.error = err.message;
    action.busy = false;
  }
}

function onReceiveAll(action: Action, order: PurchaseOrder) {
  action.busy = true;
  action.error = "";

  try {
    receiveAll(order.id);
  } catch (err: any) {
    action.error = err.message;
  }

  action.busy = false;
}

function onPickProduct(form: AddForm, products: LiveView<Product>) {
  let product = products.get(form.productId);

  if (product) {
    form.quantity = suggestedQuantity(product);
  }
}

function onAdd(form: AddForm, order: PurchaseOrder) {
  form.error = "";

  try {
    addLine(order.id, form.productId, form.quantity);
    form.productId = "";
    form.quantity = 1;
  } catch (err: any) {
    form.error = err.message;
  }
}

function onSetQuantity(state: LineState, line: PoLine) {
  try {
    setLineQuantity(line.id, state.quantity);
  } catch (err: any) {
    toast.error(err.message);
    state.quantity = line.quantityOrdered;
  }
}

function onRemove(line: PoLine) {
  try {
    removeLine(line.id);
  } catch (err: any) {
    toast.error(err.message);
  }
}

function onReceive(state: LineState, line: PoLine) {
  try {
    receiveLine(line.id, state.quantity);
  } catch (err: any) {
    toast.error(err.message);
  }
}

function productOptions(products: LiveView<Product>, lines: LiveView<PoLine>, order: PurchaseOrder): { value: string; label: string }[] {
  return addable(products, lines, order).map((p) => ({
    value: p.id,
    label: `${p.sku} · ${p.name} · ${p.onHand} on hand${isLow(p) ? " (low)" : ""}`,
  }));
}

<html lang="en" class="page-purchase-order" (
  orders: LiveView<PurchaseOrder>,
  lines: LiveView<PoLine>,
  products: LiveView<Product>,
  private action: Action = { error: "", busy: false },
  private add: AddForm = { productId: "", quantity: 1, error: "" },
)>
  <head>
    <title>{orders.at(0) ? poNumber(orders.at(0)!.number) : "Purchase order"} · Pallethaven</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout active="orders">
      <Alert e:if={orders.length === 0} variant="neutral" role="status">
        This purchase order was deleted. <a href="/purchase-orders">Back to purchase orders</a>
      </Alert>

      <div e:for={order of orders} class="stack is-xl">
        <div class="stack is-sm">
          <a class="crumb" href="/purchase-orders">← Purchase orders</a>
          <div class="page-head">
            <div class="po-title row">
              <h1>{poNumber(order.number)}</h1>
              <Badge variant={statusVariant(order.status)} dot>{STATUS_LABELS[order.status]}</Badge>
            </div>

            <div class="po-actions cluster">
              <AlertDialog e:if={order.status === "draft" && isManager()}
                           title={`Delete draft ${poNumber(order.number)}?`}
                           description="The draft and its lines are removed. Nothing has been sent to the supplier.">
                <Button slot="trigger" variant="ghost" disabled={action.busy}>Delete draft</Button>
                <AlertDialogFooter>
                  <AlertDialogCancel>Keep draft</AlertDialogCancel>
                  <AlertDialogAction variant="danger" onclick={() => onDelete(action, order)}>Delete draft</AlertDialogAction>
                </AlertDialogFooter>
              </AlertDialog>
              <AlertDialog e:if={order.status === "draft" && isManager()}
                           title={`Email ${poNumber(order.number)} to ${order.supplierEmail}?`}
                           description={`${order.supplierName} gets the order by email, and it can no longer be edited.`}>
                <Button slot="trigger"
                        variant="primary"
                        loading={action.busy}
                        disabled={order.lineCount === 0}>
                  Send to supplier
                </Button>
                <AlertDialogFooter>
                  <AlertDialogCancel>Cancel</AlertDialogCancel>
                  <AlertDialogAction onclick={() => onSend(action, order)}>Send</AlertDialogAction>
                </AlertDialogFooter>
              </AlertDialog>
              <Button e:if={order.status === "sent" || order.status === "partially_received"}
                      variant="primary"
                      loading={action.busy}
                      onclick={() => onReceiveAll(action, order)}>
                Receive everything remaining
              </Button>
            </div>
          </div>
        </div>

        <Alert e:if={action.error} variant="danger" description={action.error} />

        <ol class="steps" aria-label="Progress">
          <li e:for={step of STEPS}
              class={["step", stepDone(order, step) && "is-done", order.status === step && "is-current"]}>
            {STATUS_LABELS[step]}
          </li>
        </ol>

        <Card>
          <CardContent class="po-facts">
            <div>
              <div class="fact-label">Supplier</div>
              <div class="fact-value">{order.supplierName}</div>
              <div class="fact-sub">{order.supplierEmail}</div>
            </div>
            <div>
              <div class="fact-label">Created</div>
              <div class="fact-value">{formatWhen(order.createdAt)}</div>
              <div class="fact-sub">by {order.createdByName}</div>
            </div>
            <div>
              <div class="fact-label">Sent</div>
              <div class="fact-value">{order.sentAt ? formatWhen(order.sentAt) : "Not yet"}</div>
              <div e:if={order.sentAt} class="fact-sub">emailed to supplier</div>
            </div>
            <div>
              <div class="fact-label">Received</div>
              <div class="fact-value">{order.unitsReceived} of {order.unitsOrdered} units</div>
              <div e:if={order.receivedAt} class="fact-sub">complete {formatWhen(order.receivedAt)}</div>
            </div>
          </CardContent>
        </Card>

        <Table label="Order lines" class="lines-table">
          <table>
            <thead>
              <tr>
                <TableHead class="sku">SKU</TableHead>
                <TableHead wrap>Product</TableHead>
                <TableHead align="end" class="col-cost">Unit cost</TableHead>
                <TableHead align="end">Ordered</TableHead>
                <TableHead align="end">Received</TableHead>
                <TableHead align="end" class="col-total">Line total</TableHead>
                <TableHead align="end">{order.status === "draft" ? "" : "Receive"}</TableHead>
              </tr>
            </thead>
            <tbody>
              <LineRow e:for={line of sortedLines(lines)} {line} {order} />
              <tr e:if={lines.length === 0}>
                <TableCell colspan={7}>
                  <Empty title="No lines yet" description="Add a product below." />
                </TableCell>
              </tr>
            </tbody>
            <tfoot>
              <tr>
                <TableCell class="sku"></TableCell>
                <TableCell>Total</TableCell>
                <TableCell class="col-cost"></TableCell>
                <TableCell align="end">{order.unitsOrdered}</TableCell>
                <TableCell align="end">{order.unitsReceived}</TableCell>
                <TableCell align="end" class="col-total">{formatMoney(order.totalCents)}</TableCell>
                <TableCell></TableCell>
              </tr>
            </tfoot>
          </table>
        </Table>

        <Card e:if={order.status === "draft" && isManager()} title={`Add a product from ${order.supplierName}`} level={2}>
          <CardContent class="stack is-sm">
            <form class="add-line" onsubmit={() => onAdd(add, order)}>
              <Field label="Product" required reserveError={false}>
                <NativeSelect value={add.productId}
                              block
                              placeholder="Choose a product…"
                              options={productOptions(products, lines, order)}
                              onchange={() => onPickProduct(add, products)} />
              </Field>
              <Field label="Quantity" reserveError={false}>
                <NumberInput value={add.quantity} min={1} buttons="none" />
              </Field>
              <Button type="submit" disabled={!add.productId}>Add line</Button>
            </form>
            <Alert e:if={add.error} variant="danger" description={add.error} />
          </CardContent>
        </Card>
      </div>
    </Layout>
  </body>
</html>

<LineRow (
  line: PoLine,
  order: PurchaseOrder,
  private state: LineState = {
    quantity: order.status === "draft" ? line.quantityOrdered : line.quantityOrdered - line.quantityReceived,
  },
)>
  <tr class={["line-row", order.status !== "draft" && line.quantityReceived >= line.quantityOrdered && "is-complete"]}>
    <TableCell class="sku">{line.sku}</TableCell>
    <TableCell wrap><a class="row-link" href={`/products/${line.productId}`}>{line.name}</a></TableCell>
    <TableCell align="end" class="col-cost">{formatMoney(line.unitCostCents)}</TableCell>
    <TableCell align="end">
      <NumberInput e:if={order.status === "draft" && isManager()}
                   class="qty-input"
                   size="sm"
                   buttons="none"
                   min={1}
                   value={state.quantity}
                   attrs={{ "aria-label": `Quantity of ${line.name}` }}
                   onValueCommit={() => onSetQuantity(state, line)} />
      <span e:else>{line.quantityOrdered}</span>
    </TableCell>
    <TableCell align="end">{line.quantityReceived}</TableCell>
    <TableCell align="end" class="col-total">{formatMoney(line.quantityOrdered * line.unitCostCents)}</TableCell>
    <TableCell align="end">
      <Button e:if={order.status === "draft" && isManager()}
              variant="ghost"
              size="sm"
              onclick={() => onRemove(line)}>
        Remove
      </Button>
      <span e:elseif={order.status !== "draft" && line.quantityReceived >= line.quantityOrdered} class="line-done">
        ✓ Received
      </span>
      <form e:elseif={order.status !== "draft"} class="receive-form row" onsubmit={() => onReceive(state, line)}>
        <NumberInput class="qty-input"
                     size="sm"
                     buttons="none"
                     min={1}
                     max={line.quantityOrdered - line.quantityReceived}
                     value={state.quantity}
                     attrs={{ "aria-label": `Units of ${line.name} to receive` }} />
        <Button type="submit" size="sm">Receive</Button>
      </form>
    </TableCell>
  </tr>
</LineRow>
