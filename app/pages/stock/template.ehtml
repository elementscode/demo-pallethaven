import "./style.css";
import { LiveView, redirect, session } from "@elements/app";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { Card, CardContent, CardFooter } from "@elements/ui/card";
import { DataTable, DataTableColumn } from "@elements/ui/data-table";
import { Empty } from "@elements/ui/empty";
import { Field } from "@elements/ui/field";
import { Input } from "@elements/ui/input";
import { NativeSelect } from "@elements/ui/native-select";
import { NumberInput } from "@elements/ui/number-input";
import { Tabs, TabsList, TabsTrigger } from "@elements/ui/tabs";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { Viewport, Width, watchWidth } from "#app/shared/lib/viewport";
import { Product, NewProduct, createProduct, formatMoney, isLow } from "#app/shared/services/inventory";

export type StockFilter = "all" | "low";

export interface SupplierOption {
  id: string;
  name: string;
}

interface StockState {
  filter: StockFilter;
  search: string;
}

interface ProductForm extends NewProduct {
  open: boolean;
  error: string;
}

export function matches(p: Product, state: StockState): boolean {
  if (state.filter === "low" && !isLow(p)) {
    return false;
  }

  let q = state.search.trim().toLowerCase();

  if (!q) {
    return true;
  }

  return (
    p.sku.toLowerCase().includes(q) ||
    p.name.toLowerCase().includes(q) ||
    p.supplierName.toLowerCase().includes(q)
  );
}

function visible(products: LiveView<Product>, state: StockState): Product[] {
  return products
    .filter((p) => matches(p, state))
    .sort((a, b) => a.sku.localeCompare(b.sku));
}

function inventoryValue(products: LiveView<Product>): number {
  return products.reduce((sum, p) => sum + p.onHand * p.costCents, 0);
}

function onFilter(state: StockState, filter: StockFilter) {
  state.filter = filter;

  let url = filter === "low" ? "/?filter=low" : "/";
  history.replaceState(null, "", url);
}

function emptyForm(suppliers: SupplierOption[]): ProductForm {
  return {
    open: false,
    error: "",
    sku: "",
    name: "",
    supplierId: suppliers[0]?.id ?? "",
    cost: "",
    onHand: 0,
    reorderPoint: 0,
  };
}

function onCreate(form: ProductForm) {
  try {
    let id = createProduct({
      sku: form.sku,
      name: form.name,
      supplierId: form.supplierId,
      cost: form.cost,
      onHand: form.onHand,
      reorderPoint: form.reorderPoint,
    });

    redirect(`/products/${id}`);
  } catch (err: any) {
    form.error = err.message;
  }
}

function stockLabel(p: Product): string {
  if (p.onHand === 0) {
    return "Out";
  }

  return isLow(p) ? "Low" : "In stock";
}

function stockTone(p: Product): "danger" | "warning" | "success" {
  if (p.onHand === 0) {
    return "danger";
  }

  return isLow(p) ? "warning" : "success";
}

function columns(width: Width): DataTableColumn[] {
  return [
    { key: "sku", header: "SKU", cell: (row) => ({ text: (row as Product).sku, mono: true, muted: true }) },
    {
      key: "name",
      header: "Product",
      rowHeader: true,
      wrap: true,
      cell: (row) => ({
        text: (row as Product).name,
        href: `/products/${(row as Product).id}`,
        description: width === "phone" ? (row as Product).sku : undefined,
      }),
    },
    { key: "supplierName", header: "Supplier" },
    { id: "cost", header: "Cost", align: "end", value: (row) => formatMoney((row as Product).costCents) },
    { key: "onHand", header: "On hand", type: "number" },
    { key: "reorderPoint", header: "Reorder at", type: "number" },
    {
      id: "status",
      header: "Status",
      value: (row) => stockLabel(row as Product),
      cell: (row) => ({ text: stockLabel(row as Product), tone: stockTone(row as Product) }),
    },
  ];
}

function hiddenColumns(width: Width): string[] {
  switch (width) {
    case "phone":
      return ["sku", "supplierName", "cost"];

    case "narrow":
      return ["supplierName", "cost"];

    default:
      return [];
  }
}

/** Phones: fixed widths so all four columns fit, the product name wrapping. */
function columnSizes(width: Width): Record<string, number> {
  return width === "phone" ? { name: 98, onHand: 80, reorderPoint: 93, status: 87 } : {};
}

function rowTone(row: Product): string {
  if (row.onHand === 0) {
    return "danger";
  }

  return isLow(row) ? "warning" : "";
}

<html lang="en" class="page-stock" (
  products: LiveView<Product>,
  suppliers: SupplierOption[],
  initialFilter: StockFilter,
  private state: StockState = { filter: initialFilter, search: "" },
  private form: ProductForm = emptyForm(suppliers),
  private viewport: Viewport = { width: "wide" },
  private release: () => void = () => {},
)>
  <head>
    <title>Stock · Pallethaven</title>
    <meta name="description" content="Stock levels">
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout active="stock">
      <div class="stack is-xl">
        <div class="page-head">
          <div>
            <h1>Stock</h1>
            <p class="page-sub">Everything in the warehouse, live as it moves.</p>
          </div>
          <Button e:if={session.get("role") === "manager" && !form.open}
                  variant="primary"
                  onclick={() => form.open = true}>
            New product
          </Button>
        </div>

        <Card e:if={form.open} title="New product" level={2} class="new-product">
          <form onsubmit={() => onCreate(form)}>
            <CardContent class="stack">
              <Alert e:if={form.error} variant="danger" description={form.error} />
              <div class="product-grid">
                <Field label="SKU" required>
                  <Input value={form.sku} placeholder="CP-1014" attrs={{ autocapitalize: "characters", spellcheck: "false" }} />
                </Field>
                <Field label="Name" required>
                  <Input value={form.name} placeholder="Linen Apron" />
                </Field>
                <Field label="Supplier">
                  <NativeSelect value={form.supplierId} block options={suppliers.map((s) => ({ value: s.id, label: s.name }))} />
                </Field>
                <Field label="Unit cost" required>
                  <Input value={form.cost} placeholder="12.50" attrs={{ inputmode: "decimal" }} />
                </Field>
                <Field label="On hand">
                  <NumberInput value={form.onHand} min={0} />
                </Field>
                <Field label="Reorder point">
                  <NumberInput value={form.reorderPoint} min={0} />
                </Field>
              </div>
            </CardContent>
            <CardFooter>
              <Button variant="ghost" onclick={() => form = emptyForm(suppliers)}>Cancel</Button>
              <Button type="submit" variant="primary">Add product</Button>
            </CardFooter>
          </form>
        </Card>

        <div class="stats">
          <div class="stat">
            <div class="stat-label">Products</div>
            <div class="stat-value">{products.length}</div>
          </div>
          <div class={["stat", products.filter(isLow).length > 0 && "is-alert"]}>
            <div class="stat-label">At or under reorder</div>
            <div class="stat-value">{products.filter(isLow).length}</div>
          </div>
          <div class="stat">
            <div class="stat-label">Out of stock</div>
            <div class="stat-value">{products.filter((p) => p.onHand === 0).length}</div>
          </div>
          <div class="stat">
            <div class="stat-label">Stock value at cost</div>
            <div class="stat-value">{formatMoney(inventoryValue(products))}</div>
          </div>
        </div>

        <div class="stack is-md" oninsert={() => release = watchWidth(viewport)} onremove={() => release()}>
          <div class="toolbar">
            <Tabs value={state.filter} onValueChange={(v) => onFilter(state, v as StockFilter)}>
              <TabsList label="Stock filter">
                <TabsTrigger value="all">All<span class="tab-count">{products.length}</span></TabsTrigger>
                <TabsTrigger value="low">Low stock<span class="tab-count">{products.filter(isLow).length}</span></TabsTrigger>
              </TabsList>
            </Tabs>
            <Input class="search"
                   type="search"
                   value={state.search}
                   placeholder="Search SKU, product or supplier"
                   attrs={{ "aria-label": "Search products" }} />
          </div>

          <DataTable class="stock-table"
                     data={visible(products, state)}
                     columns={columns(viewport.width)}
                     hidden={hiddenColumns(viewport.width)}
                     sizes={columnSizes(viewport.width)}
                     label="Stock"
                     rowId={(row) => (row as Product).id}
                     rowTone={(row) => rowTone(row as Product)}
                     toolbar={false}
                     footer={false}
                     pagination={false}
                     sortable={false}
                     columnMenu={false}
                     resizable={false}
                     reorderable={false}>
            <Empty slot="empty"
                   title={state.filter === "low" && !state.search ? "Nothing is at or under its reorder point." : "No products match that search."} />
          </DataTable>
        </div>
      </div>
    </Layout>
  </body>
</html>
