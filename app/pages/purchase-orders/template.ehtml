import "./style.css";
import { LiveView, redirect, session } from "@elements/app";
import { Alert } from "@elements/ui/alert";
import { Button } from "@elements/ui/button";
import { DataTable, DataTableColumn } from "@elements/ui/data-table";
import { Empty } from "@elements/ui/empty";
import { NativeSelect } from "@elements/ui/native-select";
import { Tabs, TabsList, TabsTrigger } from "@elements/ui/tabs";
import favicon from "#app/shared/assets/favicons/favicon.svg";
import { Layout } from "#app/shared/templates/layout";
import { formatDay } from "#app/shared/lib/format";
import { Viewport, Width, watchWidth } from "#app/shared/lib/viewport";
import { Product, formatMoney, isLow } from "#app/shared/services/inventory";
import {
  PoStatus,
  PurchaseOrder,
  STATUS_LABELS,
  createPurchaseOrder,
  poNumber,
  statusVariant,
} from "#app/shared/services/purchasing";

export interface SupplierOption {
  id: string;
  name: string;
}

type Filter = PoStatus | "all";

interface ListState {
  filter: Filter;
}

interface NewOrder {
  supplierId: string;
  error: string;
  busy: boolean;
}

const FILTERS: Filter[] = ["all", "draft", "sent", "partially_received", "received"];

function filterLabel(filter: Filter): string {
  return filter === "all" ? "All" : STATUS_LABELS[filter];
}

function countFor(orders: LiveView<PurchaseOrder>, filter: Filter): number {
  return orders.filter((o) => filter === "all" || o.status === filter).length;
}

function visible(orders: LiveView<PurchaseOrder>, filter: Filter): PurchaseOrder[] {
  return orders
    .filter((o) => filter === "all" || o.status === filter)
    .sort((a, b) => b.number - a.number);
}

function lowCount(products: LiveView<Product>, supplierId: string): number {
  return products.filter((p) => p.supplierId === supplierId && isLow(p)).length;
}

function supplierOptions(suppliers: SupplierOption[], products: LiveView<Product>): { value: string; label: string }[] {
  return suppliers.map((s) => ({ value: s.id, label: `${s.name} (${lowCount(products, s.id)} low)` }));
}

function onCreate(form: NewOrder) {
  form.busy = true;

  try {
    let id = createPurchaseOrder(form.supplierId);
    redirect(`/purchase-orders/${id}`);
  } catch (err: any) {
    form.error = err.message;
    form.busy = false;
  }
}

function columns(width: Width): DataTableColumn[] {
  return [
    {
      id: "order",
      header: "Order",
      rowHeader: true,
      value: (row) => poNumber((row as PurchaseOrder).number),
      cell: (row) => ({
        text: poNumber((row as PurchaseOrder).number),
        href: `/purchase-orders/${(row as PurchaseOrder).id}`,
        mono: true,
        description: width === "wide" ? undefined : (row as PurchaseOrder).supplierName,
      }),
    },
    { key: "supplierName", header: "Supplier" },
    {
      id: "status",
      header: "Status",
      value: (row) => STATUS_LABELS[(row as PurchaseOrder).status],
      cell: (row) => ({ text: STATUS_LABELS[(row as PurchaseOrder).status], tone: statusVariant((row as PurchaseOrder).status) }),
    },
    { key: "lineCount", header: "Lines", type: "number" },
    { id: "total", header: "Total", align: "end", value: (row) => formatMoney((row as PurchaseOrder).totalCents) },
    {
      id: "received",
      header: "Received",
      cell: (row) => {
        let o = row as PurchaseOrder;

        if (o.status === "draft") {
          return { text: "Not sent", muted: true };
        }

        return { text: `${o.unitsReceived}/${o.unitsOrdered}`, progress: o.unitsOrdered === 0 ? 0 : o.unitsReceived / o.unitsOrdered };
      },
    },
    {
      id: "created",
      header: "Created",
      value: (row) => formatDay((row as PurchaseOrder).createdAt),
      cell: (row) => ({ text: formatDay((row as PurchaseOrder).createdAt), description: (row as PurchaseOrder).createdByName }),
    },
  ];
}

function hiddenColumns(width: Width): string[] {
  return width === "wide" ? [] : ["supplierName", "lineCount", "received", "created"];
}

<html lang="en" class="page-purchase-orders" (
  orders: LiveView<PurchaseOrder>,
  products: LiveView<Product>,
  suppliers: SupplierOption[],
  private state: ListState = { filter: "all" as Filter },
  private form: NewOrder = { supplierId: suppliers[0]?.id ?? "", error: "", busy: false },
  private viewport: Viewport = { width: "wide" },
  private release: () => void = () => {},
)>
  <head>
    <title>Purchase orders · Pallethaven</title>
    <link rel="icon" type="image/svg+xml" href={favicon} />
  </head>
  <body>
    <Layout active="orders">
      <div class="stack is-xl">
        <div class="page-head">
          <div>
            <h1>Purchase orders</h1>
            <p class="page-sub">Draft from low stock, send to the supplier, receive line by line.</p>
          </div>

          <form e:if={session.get("role") === "manager"} class="new-po row" onsubmit={() => onCreate(form)}>
            <NativeSelect value={form.supplierId}
                          options={supplierOptions(suppliers, products)}
                          attrs={{ "aria-label": "Supplier for the new order" }} />
            <Button type="submit" variant="primary" loading={form.busy}>New order</Button>
          </form>
        </div>

        <Alert e:if={form.error} variant="danger" description={form.error} />

        <div class="stack is-md" oninsert={() => release = watchWidth(viewport)} onremove={() => release()}>
          <div class="toolbar">
            <Tabs value={state.filter} onValueChange={(v) => state.filter = v as Filter}>
              <TabsList label="Order status">
                <TabsTrigger e:for={f of FILTERS} value={f}>
                  {filterLabel(f)}<span class="tab-count">{countFor(orders, f)}</span>
                </TabsTrigger>
              </TabsList>
            </Tabs>
          </div>

          <DataTable data={visible(orders, state.filter)}
                     columns={columns(viewport.width)}
                     label="Purchase orders"
                     rowId={(row) => (row as PurchaseOrder).id}
                     hidden={hiddenColumns(viewport.width)}
                     toolbar={false}
                     footer={false}
                     pagination={false}
                     sortable={false}
                     columnMenu={false}
                     resizable={false}
                     reorderable={false}>
            <Empty slot="empty" title={`No ${state.filter === "all" ? "" : filterLabel(state.filter).toLowerCase()} orders.`} />
          </DataTable>
        </div>
      </div>
    </Layout>
  </body>
</html>
